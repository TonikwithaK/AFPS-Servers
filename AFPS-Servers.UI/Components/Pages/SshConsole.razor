@page "/ssh-console/{serverId:int}"
@inject IServerService ServerService
@inject ISshService SshService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>SSH Console - @(server?.Name ?? "Loading...")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>SSH Console - @(server?.Name ?? "Loading...")</h1>
    <button class="btn btn-outline-secondary" @onclick="BackToServer">
        ← Back to Server
    </button>
</div>

@if (server == null)
{
    <p><em>Loading server...</em></p>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="console-output" style="background-color: #1e1e1e; color: #ffffff; font-family: 'Consolas', 'Monaco', 'Courier New', monospace; padding: 15px; border-radius: 5px; height: 400px; overflow-y: auto; margin-bottom: 15px;" @ref="consoleElement" id="console-output">
                @foreach (var line in consoleOutput)
                {
                    <div class="console-line">@((MarkupString)line)</div>
                }
            </div>

            <div class="input-group">
                <span class="input-group-text console-prompt">$</span>
                <input type="text" class="form-control" @bind="currentCommand" @onkeypress="HandleKeyPress" 
                       placeholder="Enter SSH command..." @ref="commandInput" disabled="@isExecuting" />
                <button class="btn btn-primary" @onclick="ExecuteCommand" disabled="@isExecuting">
                    @if (isExecuting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Execute
                </button>
                @if (isStreaming)
                {
                    <button class="btn btn-danger" @onclick="StopCommand">Stop</button>
                }
            </div>
            
            <div class="mt-2">
                <small class="text-muted">
                    Connected to @server.Host as @server.Username
                </small>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

<style>
    .console-prompt {
        background-color: #2d2d30;
        color: #22d3ee;
        border-color: #404040;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    }
    
    .console-line {
        line-height: 1.4;
        margin: 2px 0;
    }
    
    .form-control:disabled {
        opacity: 0.6;
    }
</style>

@code {
    [Parameter] public int ServerId { get; set; }
    
    private ServerDto? server;
    private SshConfig? sshConfig;
    private List<string> consoleOutput = new();
    private string currentCommand = "";
    private bool isExecuting = false;
    private string? errorMessage;
    private ElementReference consoleElement;
    private ElementReference commandInput;
    private CancellationTokenSource? cancellationTokenSource;
    private bool isStreaming = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            server = await ServerService.GetServerByIdAsync(ServerId);
            if (server != null)
            {
                sshConfig = new SshConfig
                {
                    Host = server.Host,
                    Port = 22,
                    Username = server.Username ?? "root",
                    Password = server.Password ?? ""
                };
                
                AddToConsole($"<span style='color: #22d3ee;'>Connected to {server.Name} ({server.Host})</span>");
                AddToConsole($"<span style='color: #6c757d;'>Ready to execute commands</span>");
                AddToConsole($"<span style='color: #6c757d;'>Tip: Add '--stream' or '-s' to any command for real-time output</span>");
            }
            else
            {
                errorMessage = "Server not found";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading server: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            await commandInput.FocusAsync();
        }
        
        await ScrollToBottom();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isExecuting)
        {
            await ExecuteCommand();
        }
    }

    private async Task ExecuteCommand()
    {
        if (string.IsNullOrWhiteSpace(currentCommand) || sshConfig == null || isExecuting)
            return;

        var command = currentCommand.Trim();
        AddToConsole($"<span style='color: #d946ef;'>$ {command}</span>");
        
        currentCommand = "";
        isExecuting = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            cancellationTokenSource = new CancellationTokenSource();
            
            // Use streaming if command ends with " --stream" or " -s"
            if (command.EndsWith(" --stream") || command.EndsWith(" -s"))
            {
                var actualCommand = command.Replace(" --stream", "").Replace(" -s", "");
                await ExecuteStreamingCommand(actualCommand);
            }
            else
            {
                var result = await SshService.RunCommandAsync(sshConfig, command);
                
                if (!string.IsNullOrEmpty(result.Trim()))
                {
                    var lines = result.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                    foreach (var line in lines)
                    {
                        AddToConsole(System.Web.HttpUtility.HtmlEncode(line.Trim()));
                    }
                }
                else
                {
                    AddToConsole("<span style='color: #6c757d;'>(no output)</span>");
                }
            }
        }
        catch (Exception ex)
        {
            AddToConsole($"<span style='color: #dc3545;'>Error: {ex.Message}</span>");
        }
        finally
        {
            isExecuting = false;
            isStreaming = false;
            cancellationTokenSource?.Dispose();
            cancellationTokenSource = null;
            StateHasChanged();
            
            await Task.Delay(50);
            await commandInput.FocusAsync();
        }
    }


    private async Task ExecuteStreamingCommand(string command)
    {
        if (sshConfig == null) return;
        
        isStreaming = true;
        StateHasChanged();
        
        try
        {
            await SshService.StreamCommandAsync(sshConfig, command, (output) =>
            {
                InvokeAsync(() =>
                {
                    if (!string.IsNullOrEmpty(output.Trim()))
                    {
                        var lines = output.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
                        foreach (var line in lines)
                        {
                            if (!string.IsNullOrEmpty(line.Trim()))
                            {
                                AddToConsole(System.Web.HttpUtility.HtmlEncode(line.Trim()));
                            }
                        }
                    }
                });
            }, cancellationTokenSource?.Token ?? CancellationToken.None);
        }
        catch (OperationCanceledException)
        {
            AddToConsole("<span style='color: #d946ef;'>Command stopped</span>");
        }
        catch (Exception ex)
        {
            AddToConsole($"<span style='color: #dc3545;'>Streaming error: {ex.Message}</span>");
        }
    }

    private void StopCommand()
    {
        cancellationTokenSource?.Cancel();
        AddToConsole("<span style='color: #d946ef;'>Stopping command...</span>");
    }

    private void AddToConsole(string message)
    {
        consoleOutput.Add(message);
        
        // Keep only last 100 lines to prevent memory issues
        if (consoleOutput.Count > 100)
        {
            consoleOutput.RemoveAt(0);
        }
        
        StateHasChanged();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            if (consoleElement.Context != null)
            {
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('console-output').scrollTop = document.getElementById('console-output').scrollHeight");
            }
        }
        catch
        {
            // Ignore scrolling errors
        }
    }

    private void BackToServer()
    {
        Navigation.NavigateTo($"/server/{ServerId}");
    }

    public void Dispose()
    {
        cancellationTokenSource?.Cancel();
        cancellationTokenSource?.Dispose();
    }
}