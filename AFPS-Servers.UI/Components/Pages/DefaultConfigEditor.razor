@page "/config/default"
@using AFPS_Servers.Service.DTO
@using AFPS_Servers.Service.Interfaces
@using System.Text
@inject IServerConfigService ServerConfigService
@inject IWarforkServerConfigService WarforkConfigService
@inject IPresetService PresetService

<h3>Default Config Preset</h3>
<p class="text-muted">Applied to any server that has no server-specific config saved yet.</p>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @statusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i> @errorMessage
        </div>
    }

    <div class="card">
        <div class="card-body">
            <PresetToolbar ServerName="preset"
                           GetContent="@(() => WarforkConfigService.GenerateConfigContent(parsed ?? new()))"
                           OnLoad="@HandlePresetLoaded" />
            <hr />

            <!-- Exec Section -->
            <h6 class="text-uppercase text-muted small fw-bold mt-3">Exec</h6>
            @RenderEntryList(parsed!.Execs, "exec", execDragIndex, (i) => execDragIndex = i)
            <button class="btn btn-outline-secondary btn-sm mt-1" @onclick="() => OpenAddModal(parsed.Execs, false)">
                <i class="fas fa-plus"></i> Add Exec
            </button>

            <hr />

            <!-- CVars Section -->
            <h6 class="text-uppercase text-muted small fw-bold mt-3">CVars</h6>
            <div class="row">
                @foreach (var entry in parsed.Cvars.OrderBy(x => x.Name))
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="form-group">
                            <label class="form-label fw-bold">@entry.Name</label>
                            <div class="input-group input-group-sm">
                                <select class="form-select form-select-sm" style="max-width:90px"
                                        @bind="entry.Directive">
                                    <option value="set">set</option>
                                    <option value="seta">seta</option>
                                    <option value="setu">setu</option>
                                    <option value="sets">sets</option>
                                </select>
                                <input type="text" class="form-control"
                                       @bind="entry.Value"
                                       @bind:event="oninput" />
                                <button class="btn btn-outline-danger" type="button"
                                        @onclick="() => parsed.Cvars.Remove(entry)">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="AddCvar">
                <i class="fas fa-plus"></i> Add CVar
            </button>

            <hr />

            <!-- Aliases Section -->
            <h6 class="text-uppercase text-muted small fw-bold mt-3">Aliases</h6>
            @RenderEntryList(parsed.Aliases, "alias", aliasDragIndex, (i) => aliasDragIndex = i)
            <button class="btn btn-outline-secondary btn-sm mt-1" @onclick="() => OpenAddModal(parsed.Aliases, true)">
                <i class="fas fa-plus"></i> Add Alias
            </button>

            <hr />

            <!-- Binds Section -->
            <h6 class="text-uppercase text-muted small fw-bold mt-3">Binds</h6>
            @RenderEntryList(parsed.Binds, "bind", bindDragIndex, (i) => bindDragIndex = i)
            <button class="btn btn-outline-secondary btn-sm mt-1" @onclick="() => OpenAddModal(parsed.Binds, true)">
                <i class="fas fa-plus"></i> Add Bind
            </button>

            <hr />
            <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <text>Saving...</text>
                }
                else
                {
                    <i class="fas fa-save me-2"></i>
                    <text>Save Default Preset</text>
                }
            </button>
        </div>
    </div>
}

<!-- Entry Modal -->
@if (showEntryModal)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingEntry == null ? "Add Entry" : "Edit Entry")</h5>
                    <button type="button" class="btn-close" @onclick="CloseEntryModal"></button>
                </div>
                <div class="modal-body">
                    @if (modalShowKey)
                    {
                        <div class="mb-3">
                            <label class="form-label">Key</label>
                            <input type="text" class="form-control" @bind="modalKey" />
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Value</label>
                        <textarea class="form-control font-monospace" rows="5" @bind="modalValue"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="SaveEntryModal">Save</button>
                    <button class="btn btn-secondary" @onclick="CloseEntryModal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add CVar Modal -->
@if (showAddCvarModal)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add CVar</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddCvarModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Directive</label>
                        <select class="form-select" @bind="newCvarDirective">
                            <option value="set">set</option>
                            <option value="seta">seta</option>
                            <option value="setu">setu</option>
                            <option value="sets">sets</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" @bind="newCvarName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Value</label>
                        <input type="text" class="form-control" @bind="newCvarValue" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="ConfirmAddCvar">Add</button>
                    <button class="btn btn-secondary" @onclick="() => showAddCvarModal = false">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ParsedConfig? parsed;
    private string? statusMessage;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving = false;

    // Drag state
    private int execDragIndex = -1;
    private int aliasDragIndex = -1;
    private int bindDragIndex = -1;

    // Entry modal state
    private bool showEntryModal = false;
    private bool modalShowKey = false;
    private string modalKey = "";
    private string modalValue = "";
    private ConfigEntry? editingEntry;
    private List<ConfigEntry>? editingList;

    // Add CVar modal
    private bool showAddCvarModal = false;
    private string newCvarDirective = "set";
    private string newCvarName = "";
    private string newCvarValue = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var content = await ServerConfigService.GetConfigAsync(null) ?? string.Empty;
            await LoadFromString(content);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading default config: {ex.Message}";
            parsed = new ParsedConfig();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadFromString(string content)
    {
        using var stream = new MemoryStream(Encoding.UTF8.GetBytes(content));
        parsed = await WarforkConfigService.ParseConfigFullAsync(stream);
    }

    private async Task HandlePresetLoaded(string content)
    {
        await LoadFromString(content);
        statusMessage = "Preset loaded.";
    }

    private async Task Save()
    {
        if (parsed == null) return;
        isSaving = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var content = WarforkConfigService.GenerateConfigContent(parsed);
            await ServerConfigService.SaveConfigAsync(null, content);
            statusMessage = "Default preset saved.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private RenderFragment RenderEntryList(List<ConfigEntry> list, string section, int dragIdx, Action<int> setDrag) => __builder =>
    {
        if (!list.Any())
        {
            __builder.OpenElement(0, "p");
            __builder.AddAttribute(1, "class", "text-muted small");
            __builder.AddContent(2, "No entries.");
            __builder.CloseElement();
            return;
        }

        __builder.OpenElement(10, "table");
        __builder.AddAttribute(11, "class", "table table-sm table-bordered align-middle mb-1");
        __builder.OpenElement(12, "tbody");

        for (int i = 0; i < list.Count; i++)
        {
            var entry = list[i];
            var idx = i;

            __builder.OpenElement(20, "tr");
            __builder.AddAttribute(21, "draggable", "true");
            __builder.AddAttribute(22, "ondragstart", EventCallback.Factory.Create(this, () => setDrag(idx)));
            __builder.AddAttribute(23, "ondragover", EventCallback.Factory.Create<DragEventArgs>(this, e => { }));
            __builder.AddAttribute(24, "ondrop", EventCallback.Factory.Create(this, () => MoveEntry(list, dragIdx, idx)));
            __builder.AddAttribute(25, "style", "cursor:grab");

            __builder.OpenElement(30, "td");
            __builder.AddAttribute(31, "style", "width:30px;text-align:center");
            __builder.AddContent(32, "⠿");
            __builder.CloseElement();

            __builder.OpenElement(40, "td");
            __builder.AddAttribute(41, "style", "width:30px");
            __builder.OpenElement(42, "button");
            __builder.AddAttribute(43, "class", "btn btn-outline-secondary btn-sm py-0 px-1");
            __builder.AddAttribute(44, "onclick", EventCallback.Factory.Create(this, () => MoveUp(list, idx)));
            __builder.AddAttribute(45, "disabled", idx == 0);
            __builder.AddContent(46, "▲");
            __builder.CloseElement();
            __builder.CloseElement();

            __builder.OpenElement(50, "td");
            __builder.AddAttribute(51, "style", "width:30px");
            __builder.OpenElement(52, "button");
            __builder.AddAttribute(53, "class", "btn btn-outline-secondary btn-sm py-0 px-1");
            __builder.AddAttribute(54, "onclick", EventCallback.Factory.Create(this, () => MoveDown(list, idx)));
            __builder.AddAttribute(55, "disabled", idx == list.Count - 1);
            __builder.AddContent(56, "▼");
            __builder.CloseElement();
            __builder.CloseElement();

            __builder.OpenElement(60, "td");
            __builder.AddAttribute(61, "class", "fw-bold");
            __builder.AddContent(62, entry.Key);
            __builder.CloseElement();

            __builder.OpenElement(70, "td");
            __builder.AddAttribute(71, "style", "cursor:pointer;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap");
            __builder.AddAttribute(72, "title", "Click to edit");
            __builder.AddAttribute(73, "onclick", EventCallback.Factory.Create(this, () => OpenEditModal(list, entry, section != "exec")));
            var preview = entry.Value.Length > 40 ? entry.Value[..40] + "…" : entry.Value;
            __builder.AddContent(74, string.IsNullOrEmpty(preview) ? "(click to edit)" : preview);
            __builder.CloseElement();

            __builder.OpenElement(80, "td");
            __builder.AddAttribute(81, "style", "width:40px");
            __builder.OpenElement(82, "button");
            __builder.AddAttribute(83, "class", "btn btn-outline-danger btn-sm py-0 px-1");
            __builder.AddAttribute(84, "onclick", EventCallback.Factory.Create(this, () => { list.Remove(entry); }));
            __builder.AddContent(85, "×");
            __builder.CloseElement();
            __builder.CloseElement();

            __builder.CloseElement();
        }

        __builder.CloseElement();
        __builder.CloseElement();
    };

    private void MoveEntry(List<ConfigEntry> list, int from, int to)
    {
        if (from < 0 || from >= list.Count || to < 0 || to >= list.Count || from == to) return;
        var item = list[from];
        list.RemoveAt(from);
        list.Insert(to, item);
    }

    private void MoveUp(List<ConfigEntry> list, int idx)
    {
        if (idx > 0) MoveEntry(list, idx, idx - 1);
    }

    private void MoveDown(List<ConfigEntry> list, int idx)
    {
        if (idx < list.Count - 1) MoveEntry(list, idx, idx + 1);
    }

    private void OpenEditModal(List<ConfigEntry> list, ConfigEntry entry, bool showKey)
    {
        editingList = list;
        editingEntry = entry;
        modalShowKey = showKey;
        modalKey = entry.Key;
        modalValue = entry.Value;
        showEntryModal = true;
    }

    private void OpenAddModal(List<ConfigEntry> list, bool showKey)
    {
        editingList = list;
        editingEntry = null;
        modalShowKey = showKey;
        modalKey = "";
        modalValue = "";
        showEntryModal = true;
    }

    private void SaveEntryModal()
    {
        if (editingEntry != null)
        {
            if (modalShowKey) editingEntry.Key = modalKey;
            editingEntry.Value = modalValue;
        }
        else if (editingList != null)
        {
            editingList.Add(new ConfigEntry { Key = modalKey, Value = modalValue });
        }
        CloseEntryModal();
    }

    private void CloseEntryModal()
    {
        showEntryModal = false;
        editingEntry = null;
        editingList = null;
    }

    private void AddCvar()
    {
        newCvarDirective = "set";
        newCvarName = "";
        newCvarValue = "";
        showAddCvarModal = true;
    }

    private void ConfirmAddCvar()
    {
        if (!string.IsNullOrWhiteSpace(newCvarName) && parsed != null)
        {
            parsed.Cvars.Add(new CvarEntry
            {
                Directive = newCvarDirective,
                Name = newCvarName,
                Value = newCvarValue
            });
        }
        showAddCvarModal = false;
    }
}
