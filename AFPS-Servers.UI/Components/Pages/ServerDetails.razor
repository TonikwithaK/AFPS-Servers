@page "/server/{Id:int}"
@using AFPS_Servers.Service.Config
@using AFPS_Servers.Service.DTO
@using AFPS_Servers.Service.Interfaces
@inject IServerService ServerService
@inject ISshService SshService
@inject ISftpService SftpService
@inject NavigationManager Navigation
@using System.Text
@using System.Threading
@implements IDisposable

<PageTitle>@(server?.Name ?? "Server Details")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@(server?.Name ?? "Server Details")</h1>
    <button class="btn btn-outline-secondary" @onclick="BackToList">
        ← Back to Servers
    </button>
</div>

@if (server == null)
{
    <p><em>Loading server details...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Server Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Name:</dt>
                        <dd class="col-sm-7">@server.Name</dd>

                        <dt class="col-sm-5">Host:</dt>
                        <dd class="col-sm-7">@server.Host</dd>

                        <dt class="col-sm-5">Username:</dt>
                        <dd class="col-sm-7">@server.Username</dd>

                        <dt class="col-sm-5">Connection:</dt>
                        <dd class="col-sm-7">SSH (Port 22)</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a class="btn btn-primary" href="@($"/ssh-console/{server.Id}")">
                            SSH Console
                        </a>
                        <a class="btn btn-outline-primary" href="@($"/server/{server.Id}/maps")">
                            Manage Maps
                        </a>
                        <a class="btn btn-outline-primary" href="@($"/server/{server.Id}/gametypes")">
                            Manage Gametypes
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Warfork Server</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-success" @onclick="@(() => RunServerCommand("setup"))" disabled="@isRunning">
                            Setup Environment
                        </button>
                        <button class="btn btn-primary" @onclick="@(() => RunServerCommand("install"))" disabled="@isRunning">
                            Install Server
                        </button>
                        <button class="btn btn-info" @onclick="@(() => RunServerCommand("update"))" disabled="@isRunning">
                            Update Server
                        </button>
                        <button class="btn btn-primary" @onclick="@(() => RunServerCommand("start"))" disabled="@isRunning">
                            Start Server
                        </button>
                        <button class="btn btn-warning" @onclick="@(() => RunServerCommand("restart"))" disabled="@isRunning">
                            Restart Server
                        </button>
                        <button class="btn btn-danger" @onclick="@(() => RunServerCommand("stop"))" disabled="@isRunning">
                            Stop Server
                        </button>
                        @if (streamingCts != null)
                        {
                            <button class="btn btn-outline-danger" @onclick="CancelOperation">
                                Cancel
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (isRunning)
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5>Command Output</h5>
            </div>
            <div class="card-body">
                <div class="console-output" style="background-color: #1e1e1e; color: #ffffff; font-family: 'Consolas', 'Monaco', 'Courier New', monospace; padding: 15px; border-radius: 5px; height: 400px; overflow-y: auto;">
                    <pre>@liveOutput</pre>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(lastCommandResult) && !isRunning)
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5>Last Command Result</h5>
            </div>
            <div class="card-body">
                <pre class="bg-dark text-light p-3 rounded">@lastCommandResult</pre>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private ServerDto? server;
    private string? lastCommandResult;
    private string? errorMessage;
    private bool isRunning = false;
    private StringBuilder liveOutput = new StringBuilder();
    private CancellationTokenSource? streamingCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            server = await ServerService.GetServerByIdAsync(Id);
            if (server == null)
            {
                Navigation.NavigateTo("/serverlist");
            }
        }
        catch (Exception)
        {
            Navigation.NavigateTo("/serverlist");
        }
    }

    private async Task RunServerCommand(string command)
    {
        if (server == null || isRunning) return;

        isRunning = true;
        errorMessage = null;
        lastCommandResult = null;
        liveOutput.Clear();
        streamingCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            // Upload the Warfork.sh script
            var sftpConfig = new SftpConfig
            {
                Host = server.Host!,
                Port = 22,
                Username = server.Username!,
                Password = server.Password!
            };

            using var sftpClient = SftpService.Connect(sftpConfig.Host, sftpConfig.Port, sftpConfig.Username, sftpConfig.Password);
            var localScriptPath = "Scripts/Warfork.sh";
            var remoteScriptPath = "/root/Warfork.sh";
            
            try
            {
                SftpService.UploadFile(sftpClient, localScriptPath, remoteScriptPath);
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to upload script: {ex.Message}";
                return;
            }
            finally
            {
                SftpService.Disconnect(sftpClient);
            }

            // Prepare SSH config
            var sshConfig = new SshConfig
            {
                Host = server.Host!,
                Port = 22,
                Username = server.Username!,
                Password = server.Password!
            };

            // Make script executable and run command
            var fullCommand = command == "setup" 
                ? $"chmod +x {remoteScriptPath} && sudo {remoteScriptPath} {command}"
                : $"chmod +x {remoteScriptPath} && {remoteScriptPath} {command}";

            // Stream the command output for real-time feedback
            await SshService.StreamCommandAsync(sshConfig, fullCommand, log =>
            {
                liveOutput.AppendLine(log);
                InvokeAsync(StateHasChanged);
            }, streamingCts.Token);

            lastCommandResult = liveOutput.ToString();
        }
        catch (OperationCanceledException)
        {
            lastCommandResult = liveOutput.ToString() + "\n[Operation cancelled by user]";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error running {command}: {ex.Message}";
            lastCommandResult = liveOutput.ToString();
        }
        finally
        {
            isRunning = false;
            streamingCts?.Dispose();
            streamingCts = null;
            StateHasChanged();
        }
    }

    private void CancelOperation()
    {
        streamingCts?.Cancel();
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/serverlist");
    }

    public void Dispose()
    {
        streamingCts?.Cancel();
        streamingCts?.Dispose();
    }
}