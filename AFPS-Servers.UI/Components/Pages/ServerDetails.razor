@page "/server/{Id:int}"
@using AFPS_Servers.Service.Config
@using AFPS_Servers.Service.DTO
@using AFPS_Servers.Service.Interfaces
@inject IServerService ServerService
@inject ISshService SshService
@inject ISftpService SftpService
@inject NavigationManager Navigation
@using System.Text
@using System.Threading
@implements IDisposable

<PageTitle>@(server?.Name ?? "Server Details")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@(server?.Name ?? "Server Details")</h1>
    <button class="btn btn-outline-secondary" @onclick="BackToList">
        ← Back to Servers
    </button>
</div>

@if (server == null)
{
    <p><em>Loading server details...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Server Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Name:</dt>
                        <dd class="col-sm-7">@server.Name</dd>

                        <dt class="col-sm-5">Host:</dt>
                        <dd class="col-sm-7">@server.Host</dd>

                        <dt class="col-sm-5">Username:</dt>
                        <dd class="col-sm-7">@server.Username</dd>

                        <dt class="col-sm-5">Connection:</dt>
                        <dd class="col-sm-7">SSH (Port 22)</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a class="btn btn-primary" href="@($"/ssh-console/{server.Id}")">
                            SSH Console
                        </a>
                        <a class="btn btn-outline-primary" href="@($"/server/{server.Id}/maps")">
                            Manage Maps
                        </a>
                        <a class="btn btn-outline-primary" href="@($"/server/{server.Id}/gametypes")">
                            Manage Gametypes
                        </a>
                        <a class="btn btn-outline-primary" href="@($"/server/{server.Id}/config")">
                            Edit Config
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Warfork Server</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-success" @onclick="@(() => RunServerCommand("setup"))" disabled="@isRunning">
                            Setup Environment
                        </button>
                        <button class="btn btn-primary" @onclick="@(() => RunServerCommand("install"))" disabled="@isRunning">
                            Install Server
                        </button>
                        <button class="btn btn-info" @onclick="@(() => RunServerCommand("update"))" disabled="@isRunning">
                            Update Server
                        </button>
                        <button class="btn btn-primary" @onclick="@(() => RunServerCommand("start"))" disabled="@isRunning">
                            Start Server
                        </button>
                        <button class="btn btn-warning" @onclick="@(() => RunServerCommand("restart"))" disabled="@isRunning">
                            Restart Server
                        </button>
                        <button class="btn btn-danger" @onclick="@(() => RunServerCommand("stop"))" disabled="@isRunning">
                            Stop Server
                        </button>
                        <button class="btn btn-danger" @onclick="@(() => RunServerCommand("killall"))" disabled="@isRunning">
                            Kill All Servers
                        </button>
                        @if (streamingCts != null)
                        {
                            <button class="btn btn-outline-danger" @onclick="CancelOperation">
                                Cancel
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (isRunning)
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5>Command Output</h5>
            </div>
            <div class="card-body">
                <div class="console-output" style="background-color: #1e1e1e; color: #ffffff; font-family: 'Consolas', 'Monaco', 'Courier New', monospace; padding: 15px; border-radius: 5px; height: 400px; overflow-y: auto;">
                    <pre>@liveOutput</pre>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(lastCommandResult) && !isRunning)
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5>Last Command Result</h5>
            </div>
            <div class="card-body">
                <pre class="bg-dark text-light p-3 rounded">@lastCommandResult</pre>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private ServerDto? server;
    private string? lastCommandResult;
    private string? errorMessage;
    private bool isRunning = false;
    private StringBuilder liveOutput = new StringBuilder();
    private CancellationTokenSource? streamingCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            server = await ServerService.GetServerByIdAsync(Id);
            if (server == null)
            {
                Navigation.NavigateTo("/serverlist");
            }
        }
        catch (Exception)
        {
            Navigation.NavigateTo("/serverlist");
        }
    }

    private async Task RunServerCommand(string command)
    {
        if (server == null || isRunning) return;

        isRunning = true;
        errorMessage = null;
        lastCommandResult = null;
        liveOutput.Clear();
        streamingCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var sshConfig = new SshConfig
            {
                Host = server.Host!,
                Port = 22,
                Username = server.Username!,
                Password = server.Password!
            };

            if (command == "killall")
            {
                // killall doesn't use the script — run directly via RunCommandAsync
                var killCommand = "for s in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^wf-'); do tmux kill-session -t $s && echo '> Killed tmux session: '$s; done; pkill -f wf_server.x86_64 2>/dev/null && echo '> Killed stray wf_server processes' || true; echo '> Kill all complete'";
                var result = await SshService.RunCommandAsync(sshConfig, killCommand);
                liveOutput.AppendLine(string.IsNullOrWhiteSpace(result) ? "> Kill all complete (no sessions found)" : result);
                await InvokeAsync(StateHasChanged);
            }
            else
            {
            var sftpClient = SftpService.Connect(server.Host!, 22, server.Username!, server.Password!);
            var localScriptPath = "Scripts/Warfork.sh";
            var remoteScriptPath = "/root/Warfork.sh";

            try
            {
                await SftpService.UploadFileAsync(sftpClient, localScriptPath, remoteScriptPath, streamingCts.Token);
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to upload script: {ex.Message}";
                return;
            }
            finally
            {
                SftpService.Disconnect(sftpClient);
            }

            // For "start", the script exits immediately after creating a detached tmux session,
            // so we chain a follow-up check to verify the session is actually alive.
            var fullCommand = command switch
            {
                "setup"   => $"chmod +x {remoteScriptPath} && sudo {remoteScriptPath} {command}",
                "start"   => $"chmod +x {remoteScriptPath} && {remoteScriptPath} {command} && sleep 2 && if tmux list-sessions 2>/dev/null | grep -q '^wf-'; then echo '> Verified: server session is running'; else echo '> WARNING: Server session not found'; exit 1; fi",
                "stop"    => $"chmod +x {remoteScriptPath} && {remoteScriptPath} {command} && sleep 1 && if ! tmux list-sessions 2>/dev/null | grep -q '^wf-'; then echo '> Verified: server session stopped'; else echo '> WARNING: Server session still running'; exit 1; fi",
                "restart" => $"chmod +x {remoteScriptPath} && {remoteScriptPath} {command} && sleep 2 && if tmux list-sessions 2>/dev/null | grep -q '^wf-'; then echo '> Verified: server session is running'; else echo '> WARNING: Server session not found after restart'; exit 1; fi",
                _         => $"chmod +x {remoteScriptPath} && {remoteScriptPath} {command}"
            };

            await SshService.StreamCommandAsync(sshConfig, fullCommand, log =>
            {
                liveOutput.AppendLine(log);
                _ = InvokeAsync(StateHasChanged);
            }, streamingCts.Token);
            } // end else

            lastCommandResult = liveOutput.ToString();
        }
        catch (OperationCanceledException)
        {
            lastCommandResult = liveOutput.ToString() + "\n[Operation cancelled by user]";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error running {command}: {ex.Message}";
            lastCommandResult = liveOutput.ToString();
        }
        finally
        {
            isRunning = false;
            streamingCts?.Dispose();
            streamingCts = null;
            StateHasChanged();
        }
    }

    private void CancelOperation()
    {
        streamingCts?.Cancel();
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/serverlist");
    }

    public void Dispose()
    {
        streamingCts?.Cancel();
        streamingCts?.Dispose();
    }
}